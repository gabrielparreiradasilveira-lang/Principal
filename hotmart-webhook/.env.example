# Chave de serviço do Firebase (baixe em Configurações do projeto > Contas de serviço > Gerar nova
# chave privada), depois rode: base64 -i chave.json | tr -d '\n'  e cole o resultado abaixo.
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Token "Hottok" configurado na tela de Webhook da Hotmart (Ferramentas > Webhook).
HOTMART_HOTTOK=

# Mapa "ID ou nome do produto na Hotmart" -> "nome exato da certificação" cadastrada em
# Admin > Certificações no app. Exemplo com dois produtos:
HOTMART_PRODUCT_MAP={"123456":"CPA-20","789012":"CEA"}
