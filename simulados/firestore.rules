rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId && request.resource.data.role == 'aluno' &&
        (!("purchasedCertifications" in request.resource.data) || request.resource.data.purchasedCertifications.size() == 0 ||
          request.resource.data.purchasedCertifications == get(/databases/$(database)/documents/pendingAccess/$(request.auth.token.email.lower())).data.certifications);
      // Alunos podem atualizar o próprio nome/dispositivo, mas nunca o próprio "role" nem as
      // certificações liberadas (evita auto-promoção a admin ou auto-liberação de acesso pago).
      allow update: if isSignedIn() && request.auth.uid == userId &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.purchasedCertifications == resource.data.purchasedCertifications;
      allow update: if isAdmin();
    }

    match /certifications/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Preenchido só pelo webhook da Hotmart (Admin SDK, ignora estas regras) quando alguém
    // compra antes de criar conta no site. O signup consome e apaga o próprio registro.
    match /pendingAccess/{email} {
      allow read, delete: if isSignedIn() && request.auth.token.email.lower() == email;
      allow create, update: if false;
    }

    match /questions/{id} {
      // Leitura liberada para autenticados pois o app calcula a correção no cliente
      // (inclui o gabarito). Ver limitação descrita no README.
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /exams/{id} {
      allow read: if isSignedIn() && (resource.data.published == true || isAdmin());
      allow write: if isAdmin();
    }

    match /attempts/{id} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }
  }
}
